# Telegram Bot API bilgileri (BotFather'dan alınır)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsiyonel: Anthropic API anahtari (LLM Sentezci personasi icin)
# Tanimlanmazsa sistem kural-tabanli skorlamayla calismaya devam eder.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Portfoy / risk ayarlari (opsiyonel, varsayilanlar kod icinde tanimli)
MAX_WEIGHT_PER_STOCK=0.25
MAX_WEIGHT_PER_SECTOR=0.40
MIN_WEIGHT_TO_KEEP=0.03
TOP_N_PER_PERSONA=8

# BIST seans saatleri (opsiyonel)
BIST_MARKET_OPEN=10:00
BIST_MARKET_CLOSE=18:00

# Finlab veri dosyasi yolu (opsiyonel)
FINLAB_DATA_PATH=finlab_data.json

LOG_LEVEL=INFO
